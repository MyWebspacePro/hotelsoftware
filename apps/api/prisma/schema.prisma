generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ─────────────────────────────────────────────────────

enum Role {
  ADMIN
  MANAGER
  RECEPTION
  HOUSEKEEPING
  SERVICE
}

enum Country {
  DE
  AT
  CH
}

enum Currency {
  EUR
  CHF
}

// ── Organisation (Multi-Property über hotelId ab Tag 1) ──────

model Hotel {
  id           String        @id @default(cuid())
  name         String
  address      String?
  zip          String?
  city         String?
  country      Country       @default(DE)
  currency     Currency      @default(EUR)
  language     String        @default("de")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?
  users        User[]
  systemConfig SystemConfig?
  roomTypes    RoomType[]
  rooms        Room[]
  ratePlans    RatePlan[]
  priceRules   PriceRule[]
  articles     Article[]
  guests       Guest[]
  bookings     Booking[]
  reservations Reservation[]
  folios       FolioAccount[]
  folioEntries FolioEntry[]
  invoices     Invoice[]
  payments     Payment[]
  invoiceSeries InvoiceSeries[]
  dayClosings  DayClosing[]
  accountMappings AccountMapping[]
  touristTaxConfigs TouristTaxConfig[]

  @@map("hotels")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  firstName    String
  lastName     String
  role         Role      @default(RECEPTION)
  active       Boolean   @default(true)
  hotelId      String?
  hotel        Hotel?    @relation(fields: [hotelId], references: [id])
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  @@map("users")
}

model SystemConfig {
  id        String   @id @default(cuid())
  hotelId   String   @unique
  hotel     Hotel    @relation(fields: [hotelId], references: [id])
  // DACH-Konfiguration: USt-Matrix, Kurtaxe, Meldeprofile, Löschfristen, Optionen
  config    Json     @default("{}")
  updatedAt DateTime @updatedAt

  @@map("system_configs")
}

model AuditLog {
  id        String   @id @default(cuid())
  hotelId   String?
  userId    String?
  entity    String
  entityId  String?
  action    String
  before    Json?
  after     Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([hotelId, createdAt])

  @@map("audit_logs")
}

// ── Stammdaten & Preise (Phase 1) ────────────────────────────

enum BoardBasis {
  NUR_LOGIS
  UE_F
  HP
}

enum BookingStatus {
  INQUIRY
  OFFERED
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  NO_SHOW
}

enum BookingSource {
  WEBSITE_REQUEST
  PHONE
  EMAIL
  WALK_IN
  ICAL
}

enum ArticleCategory {
  FOOD
  DRINK
  SPA
  SKISERVICE
  OTHER
}

// ── Abrechnung (Phase 2) ─────────────────────────────────────

enum FolioType {
  GUEST
  GROUP
  COMPANY
}

enum FolioEntryKind {
  CHARGE
  CREDIT
  DISCOUNT
}

enum InvoiceType {
  STANDARD
  ADVANCE
  CREDIT
  CONSOLIDATED
}

enum InvoiceStatus {
  ISSUED
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  SEPA
  ONLINE
  VOUCHER
  TRANSFER
}

enum FibuFormat {
  DATEV
  GENERIC
}

model FolioAccount {
  id        String       @id @default(cuid())
  hotelId   String
  hotel     Hotel        @relation(fields: [hotelId], references: [id])
  bookingId String?
  booking   Booking?     @relation(fields: [bookingId], references: [id])
  type      FolioType    @default(GUEST)
  title     String?
  open      Boolean      @default(true)
  entries   FolioEntry[]
  invoices  Invoice[]
  payments  Payment[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  deletedAt DateTime?

  @@index([hotelId, bookingId])
  @@map("folio_accounts")
}

model FolioEntry {
  id           String         @id @default(cuid())
  hotelId      String
  hotel        Hotel          @relation(fields: [hotelId], references: [id])
  folioId      String
  folio        FolioAccount   @relation(fields: [folioId], references: [id])
  kind         FolioEntryKind @default(CHARGE)
  articleId    String?
  article      Article?       @relation(fields: [articleId], references: [id])
  text         String
  qty          Int            @default(1)
  unitPriceCents Int
  totalCents   Int
  taxRateKey   String
  taxRate      Float          @default(0)
  taxCategory  String         @default("OTHER") // LOGIS | FOOD | OTHER
  isTouristTax Boolean        @default(false)
  nightDate    DateTime?      @db.Date
  source       String         @default("MANUAL") // MANUAL | AUTO_STAY | REVERSAL
  invoiceId    String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  deletedAt    DateTime?

  @@index([hotelId, folioId])
  @@map("folio_entries")
}

model Invoice {
  id           String        @id @default(cuid())
  hotelId      String
  hotel        Hotel         @relation(fields: [hotelId], references: [id])
  number       String
  series       String
  type         InvoiceType   @default(STANDARD)
  status       InvoiceStatus @default(ISSUED)
  bookingId    String?
  booking      Booking?      @relation(fields: [bookingId], references: [id])
  folioId      String?
  folio        FolioAccount? @relation(fields: [folioId], references: [id])
  guestId      String?
  guest        Guest?        @relation(fields: [guestId], references: [id])
  guestName    String?
  currency     String        @default("EUR")
  date         DateTime
  netCents     Int
  taxCents     Int
  grossCents   Int
  taxBreakdown Json          @default("[]")
  lines        InvoiceLine[]
  payments     Payment[]
  cancelOfId   String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?

  @@unique([hotelId, number])
  @@index([hotelId, date])
  @@map("invoices")
}

model InvoiceLine {
  id             String   @id @default(cuid())
  invoiceId      String
  invoice        Invoice  @relation(fields: [invoiceId], references: [id])
  position       Int
  text           String
  qty            Int
  unitPriceCents Int
  totalCents     Int
  taxRateKey     String
  taxRate        Float
  taxCategory    String
  isTouristTax   Boolean  @default(false)

  @@index([invoiceId])
  @@map("invoice_lines")
}

model Payment {
  id          String        @id @default(cuid())
  hotelId     String
  hotel       Hotel         @relation(fields: [hotelId], references: [id])
  folioId     String?
  folio       FolioAccount? @relation(fields: [folioId], references: [id])
  invoiceId   String?
  invoice     Invoice?      @relation(fields: [invoiceId], references: [id])
  method      PaymentMethod @default(CASH)
  amountCents Int
  date        DateTime
  reference   String?
  note        String?
  createdById String?
  createdAt   DateTime      @default(now())
  deletedAt   DateTime?

  @@index([hotelId, date])
  @@map("payments")
}

model InvoiceSeries {
  id         String @id @default(cuid())
  hotelId    String
  hotel      Hotel  @relation(fields: [hotelId], references: [id])
  country    Country
  year       Int
  prefix     String @default("RE")
  nextNumber Int    @default(1)

  @@unique([hotelId, country, year])
  @@map("invoice_series")
}

model DayClosing {
  id          String   @id @default(cuid())
  hotelId     String
  hotel       Hotel    @relation(fields: [hotelId], references: [id])
  date        DateTime @db.Date
  totals      Json     @default("{}") // je Zahlart {method, amountCents, count}
  taxTotals   Json     @default("[]") // je Steuer-Schlüssel {taxRateKey, netCents, taxCents}
  folioTotals Json     @default("{}") // {chargeCents, creditCents}
  closedById  String?
  closedAt    DateTime @default(now())

  @@unique([hotelId, date])
  @@map("day_closings")
}

model AccountMapping {
  id        String     @id @default(cuid())
  hotelId   String
  hotel     Hotel      @relation(fields: [hotelId], references: [id])
  format    FibuFormat @default(DATEV)
  mapping   Json       @default("{}") // FibuMapping-Struktur
  updatedAt DateTime   @updatedAt

  @@unique([hotelId, format])
  @@map("account_mappings")
}

model TouristTaxConfig {
  id        String   @id @default(cuid())
  hotelId   String
  hotel     Hotel    @relation(fields: [hotelId], references: [id])
  name      String
  validFrom DateTime @db.Date
  validTo   DateTime @db.Date
  adultCentsPerNight Int
  childUntilAge      Int    @default(15)
  childCentsPerNight Int    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@index([hotelId, validFrom])
  @@map("tourist_tax_configs")
}

model RoomType {
  id            String        @id @default(cuid())
  hotelId       String
  hotel         Hotel         @relation(fields: [hotelId], references: [id])
  name          String
  capacity      Int           @default(2)
  maxExtraBeds  Int           @default(0)
  description   String?
  basePriceCents Int          @default(12000)
  color         String        @default("#6366f1")
  rooms         Room[]
  reservations  Reservation[]
  priceRules    PriceRule[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?

  @@index([hotelId])
  @@map("room_types")
}

model Room {
  id         String        @id @default(cuid())
  hotelId    String
  hotel      Hotel         @relation(fields: [hotelId], references: [id])
  roomTypeId String
  roomType   RoomType      @relation(fields: [roomTypeId], references: [id])
  number     String
  floor      Int?
  notes      String?
  reservations Reservation[]
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  deletedAt  DateTime?

  @@unique([hotelId, number])
  @@index([hotelId, roomTypeId])
  @@map("rooms")
}

model RatePlan {
  id                String        @id @default(cuid())
  hotelId           String
  hotel             Hotel         @relation(fields: [hotelId], references: [id])
  name              String
  basis             BoardBasis    @default(NUR_LOGIS)
  cancellationTerms String?
  active            Boolean       @default(true)
  reservations      Reservation[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  deletedAt         DateTime?

  @@index([hotelId])
  @@map("rate_plans")
}

model PriceRule {
  id          String    @id @default(cuid())
  hotelId     String
  hotel       Hotel     @relation(fields: [hotelId], references: [id])
  roomTypeId  String
  roomType    RoomType  @relation(fields: [roomTypeId], references: [id])
  name        String?
  dateFrom    DateTime  @db.Date
  dateTo      DateTime  @db.Date
  priceCents  Int
  minStay     Int       @default(1)
  stopSell    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([hotelId, roomTypeId, dateFrom])
  @@map("price_rules")
}

model Article {
  id              String          @id @default(cuid())
  hotelId         String
  hotel           Hotel           @relation(fields: [hotelId], references: [id])
  name            String
  category        ArticleCategory @default(OTHER)
  taxRateKey      String
  unitPriceCents  Int
  chargeToRoom    Boolean         @default(true)
  active          Boolean         @default(true)
  folioEntries    FolioEntry[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deletedAt       DateTime?

  @@index([hotelId])
  @@map("articles")
}

model Guest {
  id               String    @id @default(cuid())
  hotelId          String
  hotel            Hotel     @relation(fields: [hotelId], references: [id])
  firstName        String
  lastName         String
  email            String?
  phone            String?
  address          String?
  zip              String?
  city             String?
  country          String?
  nationality      String?
  birthDate        DateTime? @db.Date
  idType           String?
  idNumber         String?
  marketingConsent Boolean   @default(false)
  notes            String?
  bookings         Booking[]
  invoices         Invoice[]
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  @@index([hotelId, lastName])
  @@map("guests")
}

model Booking {
  id         String        @id @default(cuid())
  hotelId    String
  hotel      Hotel         @relation(fields: [hotelId], references: [id])
  status     BookingStatus @default(INQUIRY)
  source     BookingSource @default(PHONE)
  guestId    String?
  guest      Guest?        @relation(fields: [guestId], references: [id])
  channelRef String?
  notes      String?
  reservations Reservation[]
  folios     FolioAccount[]
  invoices   Invoice[]
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  deletedAt  DateTime?

  @@index([hotelId, status])
  @@map("bookings")
}

model Reservation {
  id                  String        @id @default(cuid())
  hotelId             String
  hotel               Hotel         @relation(fields: [hotelId], references: [id])
  bookingId           String
  booking             Booking       @relation(fields: [bookingId], references: [id])
  // Spiegelt Booking.status (einheitlich beim Statuswechsel gesetzt) — ermöglicht
  // später Teil-Check-ins bei Mehrzimmerbuchungen
  status              BookingStatus @default(INQUIRY)
  roomId              String?
  room                Room?         @relation(fields: [roomId], references: [id])
  roomTypeId          String
  roomType            RoomType      @relation(fields: [roomTypeId], references: [id])
  ratePlanId          String?
  ratePlan            RatePlan?     @relation(fields: [ratePlanId], references: [id])
  dateFrom            DateTime      @db.Date
  dateTo              DateTime      @db.Date
  adults              Int           @default(2)
  children            Int           @default(0)
  pricePerNightCents  Int           @default(0)
  priceTotalCents     Int           @default(0)
  notes               String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  deletedAt           DateTime?

  @@index([hotelId, dateFrom, dateTo])
  @@index([bookingId])
  @@map("reservations")
}
