{
  "name": "@hg/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "start": "tsx --env-file=../../.env src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:push": "sh -c 'set -a; test -f ../../.env && . ../../.env; set +a; prisma db push'",
    "db:seed": "tsx --env-file=../../.env prisma/seed.ts",
    "db:studio": "sh -c 'set -a; test -f ../../.env && . ../../.env; set +a; prisma studio'"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@hg/shared": "*",
    "@prisma/client": "^6.2.1",
    "bcryptjs": "^2.4.3",
    "fastify": "^5.2.0",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.5",
    "prisma": "^6.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
